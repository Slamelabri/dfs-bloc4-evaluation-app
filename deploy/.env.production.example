# Modele de configuration de PRODUCTION.
# Le fichier .env reel n'est jamais versionne : il est genere sur la machine
# par deploy/provision.sh puis complete avec les secrets.
#
# Generer les secrets :
#   php artisan key:generate --show
#   openssl rand -hex 24        (OPSTRACK_API_TOKEN, WEBHOOK_BASIC_PASSWORD, DB_PASSWORD)

APP_NAME=OpsTrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://eval-dfs-p-tpl-20265-02.it-students.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journalisation : rotation quotidienne, 14 jours de retention, pas de debug en prod
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL : compte applicatif dedie, jamais root ni le compte de demonstration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opstrack
DB_USERNAME=opstrack_app
DB_PASSWORD=

# MongoDB : journaux techniques
MONGODB_DSN=
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=opstrack_logs
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_DATABASE=admin

# Redis : cache et sessions (le README annonce Redis, on l'utilise reellement)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Secrets applicatifs : valeurs aleatoires, jamais celles de .env.example
OPSTRACK_API_TOKEN=
WEBHOOK_BASIC_USER=
WEBHOOK_BASIC_PASSWORD=
PUBLIC_WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@eval-dfs-p-tpl-20265-02.it-students.fr"
MAIL_FROM_NAME="${APP_NAME}"
